<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NX Core Spike"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cores (tap to select):"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/coreList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pick ROM folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load mode:"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/loadModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeVfs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="VFS (fd)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/modeCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Copy to cache"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:id="@+id/folderPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Folder: (none)"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Files (tap file = run, tap folder = open):"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E1E1E"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="..."
            android:textColor="#80FF80"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
